{
  "id": "local-ai-harness",
  "name": "Local AI Open 物料库（默认助手 + 场景技能）",
  "version": "2.0.0",
  "description": "Local AI Open 的物料库。**本开源版没有角色切换机制**：应用以单一「默认助手」身份工作（roles/dev/system-prompt.md），同时具备通用对话、文件处理与开发改码能力；产品 / 测试 / 法务 / Excel 四类专业方法论改以**技能**形式提供（skills* 各目录），由默认助手在系统提示词的「场景调度」段按用户意图主动 read_skill 加载，不再靠切换角色。所有技能库对默认助手全部可见（electron/tools/skills.js 的 getSkillDirs 已改为全量挂载）。产品 / 测试场景读**你自己配置的代码目录**（{{CODE_REPO_DIR}}）。默认助手拥有全量文件读写权限（高风险），破坏性操作须经用户确认。可整体复制到其它应用使用。",
  "roles": ["dev"],
  "agents": ["dev", "pm", "qa", "excel", "legal"],
  "skills": {
    "product": ["pm-clarification", "pm-code-align", "pm-prototype", "pm-svg", "pm-field-logic", "pm-prd"],
    "qa": ["qa-intake", "qa-case-ledger", "qa-whitebox-review", "qa-blackbox", "qa-report"],
    "excel": ["xl-read", "xl-clean", "xl-transform", "xl-formula", "xl-format", "xl-chart", "xl-batch", "xl-convert"],
    "legal": ["legal-statute-lookup", "legal-contract-review", "legal-clause-extract", "legal-risk", "legal-template", "legal-ask"],
    "dev": ["dev-code-change", "dev-self-check", "dev-git-discipline", "dev-learn", "dev-rmslop"]
  },
  "conventions": {
    "product": ["pm/output-spec", "pm/global-product-rules", "pm/ask-user-rules"],
    "qa": ["qa/qa-conventions", "qa/report-contract"],
    "excel": ["excel/excel-conventions"],
    "legal": ["legal/output-spec", "legal/confidentiality", "legal/disclaimer", "legal/ask-user-rules"],
    "dev": ["dev/dev-conventions"]
  },
  "usage": {
    "roles": {
      "dev": {
        "systemPrompt": "roles/dev/system-prompt.md",
        "skillsDir": "skills-dev/",
        "conventionsDir": "conventions/dev/"
      }
    },
    "scenarioSkills": {
      "product": { "skillsDir": "skills/", "outputDir": "{{PRODUCT_OUTPUT_DIR}}", "repoRoot": "{{CODE_REPO_DIR}}" },
      "qa": { "skillsDir": "skills-qa/", "outputDir": "{{TEST_OUTPUT_DIR}}", "repoRoot": "{{CODE_REPO_DIR}}" },
      "excel": { "skillsDir": "skills-excel/", "outputDir": "{{EXCEL_OUTPUT_DIR}}" },
      "legal": { "skillsDir": "skills-legal/", "outputDir": "{{LEGAL_OUTPUT_DIR}}" }
    },
    "note": "本开源版将「角色」降级为「按用户意图调度的技能场景」：主进程只注入 roles/dev/system-prompt.md 一份提示词；scenarioSkills 列出各场景的技能库与产物目录，供二次开发参考。",
    "placeholderNote": "宿主应用（如 Local AI Open）会把 {{TOKEN}} 占位符替换为真实路径后再注入系统提示词。"
  }
}
